# Copy to .env and fill in. .env is gitignored.

# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require)
NEON_DATABASE_URL=

# OpenRouter (LLM funnel) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
APTAGENT_MODEL_CHEAP=openai/gpt-4o-mini
APTAGENT_MODEL_STRONG=anthropic/claude-sonnet-4

# Telegram bot (weekly digest)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# US Census ACS API key — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
